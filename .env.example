# 32 bytes en hexadecimal para PSK/HMAC del handshake.
# Este valor es solo de ejemplo. Cambiarlo antes de usar fuera de laboratorio.
VPN_PSK_HEX=2222222222222222222222222222222222222222222222222222222222222222


# Copia este archivo como ".env" y llena los valores reales.
# NUNCA subas el archivo ".env" real a git -- agrégalo a .gitignore.

# --- Servidor ---
# Genera con: python -m core.users <username> <password>
# (repite el comando por cada usuario que quieras agregar, y ve
# fusionando el resultado en un solo JSON)
VPN_USERS_JSON={"admin": {"salt": "...", "hash": "..."}}

# --- Cliente ---
# Opcional: si no los defines, el cliente te los va a pedir por
# terminal al conectarte (la contraseña queda oculta al escribirla).
VPN_USERNAME=admin
VPN_PASSWORD=